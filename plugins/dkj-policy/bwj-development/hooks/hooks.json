{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Aa]sana.*__create_task.*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-asana-mirror.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/closed-message-sessioncheck.ps1\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
