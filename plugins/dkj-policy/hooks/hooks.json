{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "command -v powershell >/dev/null 2>&1 || exit 127; p=$(cat); printf '%s' \"$p\" | powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-working-copy.ps1\"; rc=$?; case $rc in 0|2) exit $rc;; esac; if printf '%s' \"$p\" | grep -Eq '\"agent_id\"[[:space:]]*:' && printf '%s' \"$p\" | grep -Eiq '(^|[^[:alnum:]])git([^[:alnum:]]|$)'; then echo \"BLOCKED (guard-working-copy): PowerShell could not run this guard (exit $rc) and this is a dispatched subagent running git. The guard is what keeps a subagent off the session's checkout, so a call it cannot judge is refused rather than waved through. Retry the command once; if PowerShell stays unhealthy on this machine, say so in your deliverable and stop.\" >&2; exit 2; fi; exit $rc",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/publish-background-run.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/sessioncheck-dispatch.ps1\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/dev-preview-sessionstart.ps1\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/stopwatch-hook.ps1\" -Hook Prompt",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/logbook-hook.ps1\" -Hook Prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/stopwatch-hook.ps1\" -Hook Stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/logbook-hook.ps1\" -Hook Stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/cycle-autopark.ps1\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/closeout-gate.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
